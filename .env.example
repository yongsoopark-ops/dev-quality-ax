GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=
# Supabase PostgreSQL — Pooled(PgBouncer, 6543) 연결. 런타임(lib/prisma.ts)이 쓴다.
DATABASE_URL="postgresql://<user>:<password>@<pooler-host>:6543/postgres"
# Supabase PostgreSQL — Direct/Session Pooler(5432) 연결. prisma migrate 전용(prisma.config.ts).
DIRECT_URL="postgresql://<user>:<password>@<pooler-host>:5432/postgres"
AX_INITIAL_ADMIN_EMAIL=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
